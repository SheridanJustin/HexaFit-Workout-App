<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessApp.SettingsPage"
             Title="Settings"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="12">
            <Label Text="Settings" FontSize="50" TextColor="White" Padding="0,50,0,30" />

            <Label Text="Your Stats" FontSize="Small" TextColor="LightGray" FontAttributes="Bold" />
            <Frame BorderColor="{StaticResource BorderGray}"
                   BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="10"
                   Padding="14"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label Text="Workouts completed" TextColor="{StaticResource TextSecondary}" FontSize="16" />
                    <Label x:Name="WorkoutCountLabel" Grid.Column="1" TextColor="White" FontAttributes="Bold" FontSize="16" />
                    <Label Grid.Row="1" Text="Workouts in history" TextColor="{StaticResource TextSecondary}" FontSize="16" />
                    <Label x:Name="HistoryCountLabel" Grid.Row="1" Grid.Column="1" TextColor="White" FontAttributes="Bold" FontSize="16" />
                </Grid>
            </Frame>

            <Label Text="Data" FontSize="Small" TextColor="LightGray" FontAttributes="Bold" Margin="0,10,0,0" />
            <Button Text="Reset workout counter"
                    BackgroundColor="{StaticResource CardBackground}"
                    BorderColor="{StaticResource BorderGray}"
                    BorderWidth="1"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnResetCounterClicked" />
            <Button Text="Delete all workout history"
                    BackgroundColor="{StaticResource Danger}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnDeleteHistoryClicked" />

            <Label x:Name="VersionLabel"
                   TextColor="{StaticResource LightGray}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   Margin="0,30,0,10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
