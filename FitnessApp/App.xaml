<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessApp.App">
    <Application.Resources>
        <!-- Color Palette: keep in sync with Theme.cs, which the code-built screens use -->
        <Color x:Key="PageBackground">#212121</Color>
        <Color x:Key="CardBackground">#333333</Color>
        <Color x:Key="InputBackground">#2A2A2A</Color>
        <Color x:Key="BorderGray">#8C8C8C</Color>
        <Color x:Key="TextSecondary">#D3D3D3</Color>
        <Color x:Key="Danger">#E53935</Color>
        <Color x:Key="TabBarBackground">#121212</Color>

        <Color x:Key="AccentGreen">#4CAF50</Color>
        <Color x:Key="LightGray">#8E8E93</Color>

        <!-- Older keys, still referenced by some pages -->
        <Color x:Key="DarkBackground">#1C1C1E</Color>
        <Color x:Key="DarkGray">#2C2C2E</Color>
        <Color x:Key="rp">#333333</Color>
        <Color x:Key="MutedYellow">#FFD60A</Color>
        <Color x:Key="BackGroundColor">#030805</Color>
    </Application.Resources>
</Application>
