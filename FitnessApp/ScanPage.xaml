<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FitnessApp.ScanPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16" RowSpacing="16">

        <!-- Header: back button, title, subtitle -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Text="←"
                    FontSize="26"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Start"
                    Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Machine Scanner" FontSize="26" FontAttributes="Bold" TextColor="White" />
                <Label Text="Snap a gym machine to learn how to use it"
                       FontSize="14"
                       TextColor="{StaticResource LightGray}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Main card: photo preview, result and errors scroll together -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderGray}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HeightRequest="320">
                    <Grid>
                        <!-- Prompt before any photo -->
                        <VerticalStackLayout IsVisible="{Binding IsIdle}"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="14"
                                             Padding="24">
                            <Image Source="camera.png" WidthRequest="64" HeightRequest="64" Opacity="0.8">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource LightGray}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="Take or choose a photo of a machine"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Get its name, how to use it, and a video showing the movement."
                                   FontSize="14"
                                   TextColor="{StaticResource LightGray}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- The photo you picked -->
                        <Image Source="{Binding PreviewImage}"
                               IsVisible="{Binding HasImage}"
                               Aspect="AspectFill" />

                        <!-- Dimmed overlay while the server works -->
                        <Grid IsVisible="{Binding IsLoading}" BackgroundColor="#B3000000">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                   Color="{StaticResource AccentGreen}"
                                                   WidthRequest="44"
                                                   HeightRequest="44" />
                                <Label Text="Identifying machine…"
                                       FontSize="16"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Result -->
                <Border IsVisible="{Binding HasResult}"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource AccentGreen}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MACHINE" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LightGray}" CharacterSpacing="1.5" />
                        <Label Text="{Binding Prediction}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}" />
                        <BoxView HeightRequest="1" Color="{StaticResource BorderGray}" Opacity="0.4" />
                        <Label Text="HOW TO USE" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LightGray}" CharacterSpacing="1.5" />
                        <Label Text="{Binding Instructions}" FontSize="15" TextColor="{StaticResource TextSecondary}" LineHeight="1.2" />
                        <Button Text="▶  Watch how to use it"
                                Command="{Binding WatchVideoCommand}"
                                BackgroundColor="{StaticResource Danger}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="48"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Error -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#3A2222"
                        Stroke="{StaticResource Danger}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <Label Text="{Binding ErrorMessage}" FontSize="15" TextColor="White" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions: picking a photo starts the scan straight away -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border BackgroundColor="{StaticResource AccentGreen}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="56"
                    IsEnabled="{Binding IsNotLoading}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Image Source="camera.png" WidthRequest="22" HeightRequest="22">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                    <Label Text="Take Photo" TextColor="White" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderGray}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="56"
                    IsEnabled="{Binding IsNotLoading}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Image Source="gallery.png" WidthRequest="22" HeightRequest="22">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                    <Label Text="Choose Photo" TextColor="White" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
